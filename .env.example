# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a git:
# el líder del equipo lo reparte por un canal privado. Todo el equipo debe usar los MISMOS
# valores de ENCRYPTION_KEY, JWT_KEY y DB_PASSWORD, porque todos comparten la base de Neon.

# --- Base de datos (Neon) ---
DB_PASSWORD=

# --- Claves de la API ---
# JWT_KEY: base64 de 64 bytes aleatorios. ENCRYPTION_KEY: base64 de 32 bytes aleatorios.
# Si se cambia ENCRYPTION_KEY hay que recifrar los datos existentes (ver README).
JWT_KEY=
ENCRYPTION_KEY=

# --- Postgres local (opcional, solo para trabajar sin internet) ---
POSTGRES_PASSWORD=

# --- IA local (Ollama) ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=170
