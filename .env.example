# =====================================================================================
#  Configuración local. Copia este archivo como .env y completa los valores vacíos.
#  El .env NUNCA se sube a git: el líder del equipo lo reparte por un canal privado.
#  Todo el equipo usa los MISMOS DB_PASSWORD, JWT_KEY y ENCRYPTION_KEY porque comparte
#  la base de Neon (con otra ENCRYPTION_KEY no se pueden leer los correos de los usuarios).
# =====================================================================================

# --- Base de datos: Neon (por defecto) ---
DB_HOST=ep-proud-dust-b4p707z7-pooler.c-6.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_SSLMODE=Require
DB_PASSWORD=

# --- Claves de la API (pídelas al líder; no las generes tú si usas Neon) ---
# JWT_KEY: base64 de 64 bytes aleatorios.  ENCRYPTION_KEY: base64 de 32 bytes aleatorios.
JWT_KEY=
ENCRYPTION_KEY=

# --- Primer Administrador (solo se usa si la base no tiene ninguno, p. ej. con --db-local) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULLNAME=Administrador

# --- Correo (SMTP) para recuperación de contraseña y recordatorios. Vacío = se escribe en el log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sistema-mantenimiento.local

# --- IA local (Ollama, solo CPU) ---
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=170
AI_TIMEOUT_SECONDS=190

# --- Postgres local (solo con "iniciar --db-local", para trabajar sin internet) ---
POSTGRES_PASSWORD=postgres-local

# --- Puerto de la aplicación en modo normal (http://localhost:8080) ---
APP_PORT=8080
