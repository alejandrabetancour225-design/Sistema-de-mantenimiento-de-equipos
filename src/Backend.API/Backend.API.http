@Backend.API_HostAddress = http://localhost:5255
@token = PEGA-AQUI-EL-TOKEN-DEL-ADMIN
@userId = PEGA-AQUI-EL-ID-DEL-USUARIO
@equipmentId = PEGA-AQUI-EL-ID-DEL-EQUIPO
@assignmentId = PEGA-AQUI-EL-ID-DE-LA-ASIGNACION
@componentId = PEGA-AQUI-EL-ID-DEL-COMPONENTE
@incidentId = PEGA-AQUI-EL-ID-DEL-INCIDENTE

POST {{Backend.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Juan Pérez",
  "email": "juan@test.com",
  "password": "secreto123",
  "phone": "3001234567"
}

###

POST {{Backend.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "juan@test.com",
  "password": "secreto123"
}

###

GET {{Backend.API_HostAddress}}/api/roles
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/users
Authorization: Bearer {{token}}

###

PUT {{Backend.API_HostAddress}}/api/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "active": false,
  "role": "Empleado",
  "phone": "3009876543",
  "email": "nuevo@test.com"
}

###

PUT {{Backend.API_HostAddress}}/api/users/{{userId}}/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "Técnico"
}

###

GET {{Backend.API_HostAddress}}/api/equipment/GetEquipmentList
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/equipment/GetEquipmentById/{{equipmentId}}
Authorization: Bearer {{token}}

###

POST {{Backend.API_HostAddress}}/api/equipment/PostNewEquipment
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "internalCode": "EQ-001",
  "serialNumber": "SN-ABC-123",
  "type": "Laptop",
  "brand": "Dell",
  "model": "Latitude 5420",
  "characteristics": { "ram": "16GB", "cpu": "i7", "storage": "512GB SSD" },
  "acquisitionDate": "2024-03-15",
  "acquisitionPrice": 1200.50,
  "warrantyUntil": "2027-03-15",
  "location": "Oficina 201"
}

###

PUT {{Backend.API_HostAddress}}/api/equipment/PutEquipment/{{equipmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "brand": "Dell Inc.",
  "location": "Oficina 202"
}

###

PATCH {{Backend.API_HostAddress}}/api/equipment/PatchEquipmentStatus/{{equipmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "IN_USE"
}

###

DELETE {{Backend.API_HostAddress}}/api/equipment/DeleteEquipment/{{equipmentId}}
Authorization: Bearer {{token}}

###

POST {{Backend.API_HostAddress}}/api/assignment/AssignEquipment
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "equipmentId": "{{equipmentId}}",
  "userId": "{{userId}}",
  "observations": "Entrega inicial del equipo"
}

###

PATCH {{Backend.API_HostAddress}}/api/assignment/ReleaseEquipment/{{assignmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "observations": "Devuelto en buen estado"
}

###

GET {{Backend.API_HostAddress}}/api/assignment/GetAssignments
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/equipmentcomponent/GetComponentList
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/equipmentcomponent/GetComponentById/{{componentId}}
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/equipmentcomponent/GetComponentsByEquipment/{{equipmentId}}
Authorization: Bearer {{token}}

###

POST {{Backend.API_HostAddress}}/api/equipmentcomponent/PostNewComponent
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "equipmentId": "{{equipmentId}}",
  "componentType": "RAM",
  "brand": "Kingston",
  "model": "KVR32S22S8/16",
  "serialNumber": "RAM-001",
  "specifications": { "capacity": "16GB", "speed": "3200MHz" },
  "installedAt": "2026-01-10T00:00:00Z"
}

###

PUT {{Backend.API_HostAddress}}/api/equipmentcomponent/PutComponent/{{componentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "model": "KVR32S22S8/32",
  "specifications": { "capacity": "32GB" }
}

###

DELETE {{Backend.API_HostAddress}}/api/equipmentcomponent/DeleteComponent/{{componentId}}
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/incident/GetIncidentList
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/incident/GetIncidentById/{{incidentId}}
Authorization: Bearer {{token}}

###

GET {{Backend.API_HostAddress}}/api/incident/GetIncidentsByEquipment/{{equipmentId}}
Authorization: Bearer {{token}}

###

POST {{Backend.API_HostAddress}}/api/incident/PostNewIncident
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "equipmentId": "{{equipmentId}}",
  "description": "El equipo no enciende",
  "reportedAt": "2026-09-29T00:00:00Z",
  "maintenanceId": null
}

###

PUT {{Backend.API_HostAddress}}/api/incident/PutIncident/{{incidentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "El equipo no enciende - en revision",
  "status": "IN_PROGRESS"
}

###

DELETE {{Backend.API_HostAddress}}/api/incident/DeleteIncident/{{incidentId}}
Authorization: Bearer {{token}}

###

# Usuario de la sesión actual
GET {{Backend.API_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

###

# Cualquier usuario cambia su propia contraseña
POST {{Backend.API_HostAddress}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "ClaveActual2026",
  "newPassword": "ClaveNueva2026"
}

###

# Cierra todas las sesiones del usuario (invalida sus tokens)
POST {{Backend.API_HostAddress}}/api/auth/logout
Authorization: Bearer {{token}}

###

# El Administrador restablece la contraseña de un usuario
PUT {{Backend.API_HostAddress}}/api/users/{{userId}}/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "newPassword": "NuevaClave2026"
}

###

# Auditoría (solo Administrador)
GET {{Backend.API_HostAddress}}/api/audit?take=50
Authorization: Bearer {{token}}
